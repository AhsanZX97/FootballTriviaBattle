# Production build: point the app at the deployed Render WebSocket server.
# Vite bakes this in at build time. Used by debug native builds
# (npm run android) and the Vercel web build; Vercel also sets the same value
# in its dashboard, so the two agree. Play Store bundles are built with
# `npm run cap:sync:release` instead, which loads .env.release (real ad IDs).
# No VITE_ADMOB_BANNER_ID here: production-mode builds serve AdMob TEST ads.
VITE_WS_URL=wss://football-trivia-ws.onrender.com

# Supabase project (accounts + coins). Anon key is public-safe to bake in.
# Fill in after creating the project — see Plans/Accounts and Coins Plan.md M0.
VITE_SUPABASE_URL=https://vwnponxrnjnkytgivjzr.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZ3bnBvbnhybmpua3l0Z2l2anpyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODM0OTUyOTgsImV4cCI6MjA5OTA3MTI5OH0.fet3FYm4pm6aYz0mt2S6soz9CXA15QYUGbV2C60gQDc

# PostHog product analytics. Key is public-safe to bake in (it is write-only —
# it can send events, not read them). Leave unset in local dev so your own
# play-testing never pollutes the funnel; see src/services/analytics.ts, which
# disables itself entirely when this is missing.
# VITE_POSTHOG_HOST is optional and defaults to https://us.i.posthog.com —
# set it to https://eu.i.posthog.com if you picked the EU region on signup.
VITE_POSTHOG_KEY=phc_Cs6jWhTy2g48VafiWJXTbURFv2YLvCos22HShvkv599m
VITE_POSTHOG_HOST=
