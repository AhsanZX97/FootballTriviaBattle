# Release-only build config, used by `npm run build:release` / `cap:sync:release`
# (vite --mode release). The real AdMob ad unit ID lives ONLY here so every
# other build — dev server, debug `npm run android` APKs, the Vercel web build —
# falls back to Google's test ads. Clicking real ads on your own device is how
# AdMob accounts get flagged, so never copy this ID into another env file.
#
# Note: mode `release` does NOT load .env.production, so VITE_WS_URL must be
# repeated here and kept in sync.
VITE_WS_URL=wss://football-trivia-ws.onrender.com
VITE_ADMOB_BANNER_ID=ca-app-pub-7656537208669381/4747760334

# Rewarded video unit, used by the "watch an ad for coins" button. Create it in
# AdMob (Ad units → Rewarded) and paste the id here. Left unset, EVERY build
# including release falls back to Google's test rewarded unit — coins are still
# granted, but the ad earns nothing, so fill this in before shipping.
VITE_ADMOB_REWARDED_ID=ca-app-pub-7656537208669381/9499678509

# Supabase project (accounts + coins). Anon key is public-safe to bake in.
# Mode `release` does not load .env.production, so this must match it.
VITE_SUPABASE_URL=https://vwnponxrnjnkytgivjzr.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZ3bnBvbnhybmpua3l0Z2l2anpyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODM0OTUyOTgsImV4cCI6MjA5OTA3MTI5OH0.fet3FYm4pm6aYz0mt2S6soz9CXA15QYUGbV2C60gQDc

# PostHog product analytics. Mode `release` does not load .env.production, so
# this must be kept in sync with it. Same key is fine for both — `native` on
# app_open separates Play installs from the web build in PostHog.
VITE_POSTHOG_KEY=phc_Cs6jWhTy2g48VafiWJXTbURFv2YLvCos22HShvkv599m
VITE_POSTHOG_HOST=
